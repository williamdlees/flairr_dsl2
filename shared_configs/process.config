profiles {
    docker {
        process {
            container = "williamlees/immcantation_suite_wsl_aws:4.4.0"
            cpus = 8

            withName: 'haplotype_const_report' {
                container = "williamlees/flairr_dsl2:latest"
            }

            withName: 'ogrdbstats_report' {
                container = "williamlees/ogrdbstats:latest"
            }

            withName: 'align_v' {
                container = "williamlees/flairr_dsl2:latest"
            }

            withName: 'presto_report' {
                container = "williamlees/flairr_dsl2:latest"
            }

            withName: 'filter_barcodes' {
                container = "williamlees/flairr_dsl2:latest"
            }

            withName: 'FastQC' {
                container = "williamlees/flairr_dsl2:latest"
            }
        }
    }

    singularity {
        params.sif_dir = System.getProperty('user.home') + "/sifs"

        process {
            container = "file://${params.sif_dir}/immcantation_suite-4.4.0.sif"
            cpus = 10

            withName: 'haplotype_const_report' {
                container = "file://${params.sif_dir}/flairr_dsl2_latest.sif"
            }

            withName: 'ogrdbstats_report' {
                container = "file://${params.sif_dir}/ogrdbstats_latest.sif"
            }

            withName: 'align_v' {
                container = "file://${params.sif_dir}/flairr_dsl2_latest.sif"
            }

            withName: 'presto_report' {
                container = "file://${params.sif_dir}/flairr_dsl2_latest.sif"
            }

            withName: 'filter_barcodes' {
                container = "file://${params.sif_dir}/flairr_dsl2_latest.sif"
            }

            withName: 'FastQC' {
                container = "file://${params.sif_dir}/flairr_dsl2_latest.sif"
            }
        }
    }

    awsbatch {
        aws {
            region = params.aws_batch_region
            batch {
                platformType = 'fargate'
                executionRole = System.getenv('AWS_EXECUTION_ROLE') ?: 'default'
                jobRole = System.getenv('AWS_BATCH_JOB_ROLE') ?: 'default'
                maxSpotAttempts = 3  // Allows AWS Batch to retry the job on Spot
            }            
        }

        process {
            container = "williamlees/immcantation_suite_wsl_aws:4.4.0"
            cpus = 1
            memory = '4 GB'
            time = '1 h'
            containerOptions = '' 

            errorStrategy = 'retry'
            maxRetries    = 1

            withName: 'FastQC'             {container = "williamlees/flairr_dsl2:latest"; cpus = 1; memory = '4 GB'; time = '1 h' }
            withName: 'filter_seq_quality' { cpus = 4; memory = '4 GB'; time = '1 h' }
            withName: 'filter_seq_length'  { cpus = 4; memory = '4 GB'; time = '1 h' }
            withName: 'MaskPrimers'        { cpus = 4; memory = '8 GB'; time = '1 h' }
            withName: 'filter_barcodes'    { container = "williamlees/flairr_dsl2:latest"; cpus = 2; memory = '8 GB'; time = '1 h' }
            withName: 'check_for_seqs'     { cpus = 2; memory = '8 GB'; time = '1 h' }
            withName: 'align_sets'         { cpus = 8; memory = '16 GB'; time = '4 h' }
            withName: 'cluster_sets'       { cpus = 8; memory = '8 GB'; time = '1 h' }
            withName: 'build_consensus'     { cpus = 8; memory = '8 GB'; time = '1 h' }
            withName: 'collapse_seq'       { cpus = 1; memory = '4 GB'; time = '1 h' }
            withName: 'split_seq'          { cpus = 1; memory = '4 GB'; time = '1 h' }
            withName: 'presto_report'      { container = "williamlees/flairr_dsl2:latest"; cpus = 1; memory = '4 GB'; time = '1 h' }
            withName: 'igblast'            { cpus = 8; memory = '16 GB'; time = '1 h' }
            withName: 'igblast_combo'      { cpus = 8; memory = '16 GB'; time = '1 h' }
            withName: 'makedb'             { cpus = 1; memory = '4 GB'; time = '1 h' }
            withName: 'make_blast_db'      { cpus = 1; memory = '4 GB'; time = '1 h' }
            withName: 'create_germlines'   { cpus = 1; memory = '4 GB'; time = '1 h' }
            withName: 'define_clones'      { cpus = 2; memory = '8 GB'; time = '1 h' }
            withName: 'collapse_annotations'{ cpus = 2; memory = '8 GB'; time = '1 h' }
            withName: 'single_clone_representative' { cpus = 1; memory = '4 GB'; time = '1 h' }
            withName: 'haplotype_const_report'     { container = "williamlees/flairr_dsl2:latest"; cpus = 1; memory = '4 GB'; time = '1 h' }
            withName: 'ogrdbstats_report'          { container = "williamlees/ogrdbstats:latest"; cpus = 1; memory = '4 GB'; time = '1 h' }
            withName: 'align_v'                    { container = "williamlees/flairr_dsl2:latest"; cpus = 2; memory = '8 GB'; time = '1 h' }
            withName: 'vdjbase_genotype_report'    { cpus = 1; memory = '4 GB'; time = '1 h' }
            withName: 'PIgLET_IGHV_ASC_genotype_Inference' { cpus = 2; memory = '8 GB'; time = '1 h' }
            withName: 'TIgGER_bayesian_genotype_Inference' { cpus = 2; memory = '8 GB'; time = '1 h' }
            withName: 'Undocumented_Alleles'        { cpus = 1; memory = '4 GB'; time = '1 h' }
            withName: 'airr_seq_for_clone'         { cpus = 2; memory = '8 GB'; time = '1 h' }            
            }
    }
}
