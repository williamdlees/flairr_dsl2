profiles {
    docker {
        docker.enabled = true
        singularity.enabled = false
        process {
            executor = 'local'
            errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
            maxRetries = 3
        }
    }

    singularity {
        singularity.enabled = true
        singularity.automounts = true

        process {
            executor = 'local'
            sifPath = '~/sifs'
            docker.enabled = false
            runOptions = '--cleanenv --home ~/empty --no-home'
        }
    }

    awsbatch {
        docker.enabled = false
        singularity.enabled = false
        workDir = params.aws_s3_workdir

        aws {
            region = params.aws_batch_region
        }

        params {
            aws_batch_queue = System.getenv('AWS_BATCH_JOB_QUEUE') ?: 'default'
            aws_batch_region = System.getenv('AWS_DEFAULT_REGION') ?: 'us-east-1'
            aws_s3_workdir = System.getenv('AWS_S3_WORKDIR') ?: 's3://your-bucket/nextflow-work'
            aws_batch_container_image = System.getenv('AWS_BATCH_CONTAINER_IMAGE') ?: 'public.ecr.aws/amazonlinux/amazonlinux:2'
        }

        process {
            executor = 'awsbatch'
            queue = params.aws_batch_queue
            container = params.aws_batch_container_image
            errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
            maxRetries = 3
        }
    }
}
